+def extract_version_from_build_name(build_name: str) -> str:
+    """Extract a dotted client version from WoW or Diablo III build names."""
+    wow_match = re.search(r"(\d+)patch([\d.]+)", build_name)
+    if wow_match:
+        build_id, version = wow_match.groups()
+        return f"{version}.{build_id}"
+
+    d3_match = re.search(r"^(\d+)_[^_]+_(\d+)_(\d+)_(\d+)", build_name)
+    if d3_match:
+        build_id, major, minor, patch = d3_match.groups()
+        return f"{major}.{minor}.{patch}.{build_id}"
+
+    return ""
+
