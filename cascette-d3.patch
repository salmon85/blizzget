+class TestDownloadQueueFromEnv:
+    """Tests for configurable downloader concurrency."""
+
+    def test_defaults(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        monkeypatch.delenv("CASCETTE_MAX_CONCURRENCY", raising=False)
+        monkeypatch.delenv("CASCETTE_MAX_PER_HOST", raising=False)
+
+        queue = _download_queue_from_env()
+
+        assert queue.max_concurrency == 12
+        assert queue.max_per_host == 3
+
+    def test_environment_overrides(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        monkeypatch.setenv("CASCETTE_MAX_CONCURRENCY", "48")
+        monkeypatch.setenv("CASCETTE_MAX_PER_HOST", "12")
+
+        queue = _download_queue_from_env()
+
+        assert queue.max_concurrency == 48
+        assert queue.max_per_host == 12
+
+
